07:14:42.912 chat: execute_tool_with_cache name=patch_file args={"new_text": "/// Fast fuzzy file-path finder backed by nucleo.\n///\n/// Build the index once with [`update_index`], then call [`search`] on every\n/// query keystroke. The nucleo `Matcher` is cached across calls for efficiency.\npub struct FuzzyFileFinder {\n    index: Vec<PathBuf>,\n    matcher: Matcher,\n}\n\nimpl FuzzyFileFinder {\n    pub fn new() -> Self {\n        Self {\n            index: Vec::new(),\n            matcher: Matcher::new(Config::DEFAULT),\n        }\n    }\n\n    /// Replace the file index with a fresh set of paths.\n    pub fn update_index(&mut self, files: Vec<PathBuf>) {\n        self.index = files;\n    }\n\n    /// Returns `true` if the index contains at least one path.\n    pub fn has_index(&self) -> bool {\n        !self.index.is_empty()\n    }\n\n    /// Number of files in the index.\n    pub fn index_len(&self) -> usize {\n        self.index.len()\n    }\n\n    /// Fuzzy-search the index.\n    ///\n    /// When `query` is empty, returns the first `limit` files in index order.\n    /// Otherwise scores every path with nucleo and returns the top `limit`\n    /// hits sorted by descending score.\n    pub fn search(&mut self, query: &str, limit: usize) -> Vec<FuzzyMatch> {\n        if self.index.is_empty() {\n            return Vec::new();\n        }\n\n        if query.is_empty() {\n            return self\n                .index\n                .iter()\n                .take(limit)\n                .map(|p| FuzzyMatch {\n                    display: p.to_string_lossy().into_owned(),\n                    path: p.clone(),\n                    score: 0,\n                })\n                .collect();\n        }\n\n        let pattern = Pattern::parse(query, CaseMatching::Ignore, Normalization::Smart);\n\n        let mut scored: Vec<FuzzyMatch> = self\n            .index\n            .iter()\n            .filter_map(|p| {\n                let display = p.to_string_lossy().into_owned();\n                let hay = Utf32String::from(display.as_str());\n                let score = pattern.score(hay.slice(..), &mut self.matcher)?;\n                Some(FuzzyMatch {\n                    path: p.clone(),\n                    display,\n                    score,\n                })\n            })\n            .collect();\n\n        scored.sort_by_key(|b| std::cmp::Reverse(b.score));\n        scored.truncate(limit);\n        scored\n    }\n}", "old_text": "/// Fast fuzzy file-path finder backed by nucleo.\n///\n/// Build the index once with [`update_index`], then call [`search`] on every\n/// query keystroke.\npub struct FuzzyFileFinder {\n    index: Vec<PathBuf>,\n}\n\nimpl FuzzyFileFinder {\n    pub fn new() -> Self {\n        Self { index: Vec::new() }\n    }\n\n    /// Replace the file index with a fresh set of paths.\n    pub fn update_index(&mut self, files: Vec<PathBuf>) {\n        self.index = files;\n    }\n\n    /// Returns `true` if the index contains at least one path.\n    pub fn has_index(&self) -> bool {\n        !self.index.is_empty()\n    }\n\n    /// Number of files in the index.\n    pub fn index_len(&self) -> usize {\n        self.index.len()\n    }\n\n    /// Fuzzy-search the index.\n    ///\n    /// When `query` is empty, returns the first `limit` files in index order.\n    /// Otherwise scores every path with nucleo and returns the top `limit`\n    /// hits sorted by descending score.\n    pub fn search(&self, query: &str, limit: usize) -> Vec<FuzzyMatch> {\n        if self.index.is_empty() {\n            return Vec::new();\n        }\n\n        if query.is_empty() {\n            return self\n                .index\n                .iter()\n                .take(limit)\n                .map(|p| FuzzyMatch {\n                    display: p.to_string_lossy().into_owned(),\n                    path: p.clone(),\n                    score: 0,\n                })\n                .collect();\n        }\n\n        let pattern = Pattern::parse(query, CaseMatching::Ignore, Normalization::Smart);\n        let mut matcher = Matcher::new(Config::DEFAULT);\n\n        let mut scored: Vec<FuzzyMatch> = self\n            .index\n            .iter()\n            .filter_map(|p| {\n                let display = p.to_string_lossy().into_owned();\n                let hay = Utf32String::from(display.as_str());\n                let score = pattern.score(hay.slice(..), &mut matcher)?;\n                Some(FuzzyMatch {\n                    path: p.clone(),\n                    display,\n                    score,\n                })\n            })\n            .collect();\n\n        scored.sort_by_key(|b| std::cmp::Reverse(b.score));\n        scored.truncate(limit);\n        scored\n    }\n}", "path": "crates/crabide-search/src/lib.rs"}
