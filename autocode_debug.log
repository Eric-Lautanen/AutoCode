18:12:49.986 chat: execute_tool_with_cache name=patch_file args={"new_text": "    /// Resolve the scope kind for a reference at the given byte range.\n    ///\n    /// Walks the scope tree from innermost to outermost, looking for a\n    /// definition whose byte range matches the reference's name.\n    pub fn resolve_reference(\n        &self,\n        language: &Language,\n        entry: &GrammarEntry,\n        source: &str,\n        tree: &tree_sitter::Tree,\n        ref_start_byte: usize,\n        ref_end_byte: usize,\n    ) -> ResolvedScope {\n        let query = match self.get_query(language, entry) {\n            Some(q) => q,\n            None => return ResolvedScope::Unresolved,\n        };\n\n        let source_bytes = source.as_bytes();\n        let root = tree.root_node();\n        let mut cursor = tree_sitter::QueryCursor::new();\n        let capture_names = query.capture_names();\n\n        let mut scopes: Vec<Scope> = Vec::new();\n\n        let mut matches_iter = cursor.matches(query.as_ref(), root, source_bytes);\n        while let Some(mat) = matches_iter.next() {\n            for capture in mat.captures {\n                let node = capture.node;\n                let name = &capture_names[capture.index as usize];\n\n                if *name == \"scope\" {\n                    scopes.push(Scope {\n                        start_byte: node.start_byte(),\n                        end_byte: node.end_byte(),\n                        defs: Vec::new(),\n                    });\n                } else if let Some(kind) = name.strip_prefix(\"definition.\") {\n                    let def = LocalDef {\n                        start_byte: node.start_byte(),\n                        end_byte: node.end_byte(),\n                        kind: kind.to_owned(),\n                    };\n                    if let Some(scope) = scopes.iter_mut().rev().find(|s| {\n                        node.start_byte() >= s.start_byte && node.end_byte() <= s.end_byte\n                    }) {\n                        scope.defs.push(def);\n                    }\n                }\n            }\n        }\n\n        // Sort scopes by start_byte descending (innermost first) for lookup.\n        scopes.sort_by(|a, b| b.start_byte.cmp(&a.start_byte));\n\n        // Find the definition matching the reference's text.\n        let ref_text = &source[ref_start_byte..ref_end_byte];\n\n        for scope in &scopes {\n            if ref_start_byte >= scope.start_byte && ref_end_byte <= scope.end_byte {\n                for def in &scope.defs {\n                    if def.start_byte == ref_start_byte && def.end_byte == ref_end_byte {\n                        return def_kind_to_resolved(&def.kind);\n                    }\n                    let def_text = &source[def.start_byte..def.end_byte];\n                    if def_text == ref_text {\n                        return def_kind_to_resolved(&def.kind);\n                    }\n                }\n            }\n        }\n\n        ResolvedScope::Unresolved\n    }", "old_text": "    /// Resolve the scope kind for a reference at the given byte range.\n    ///\n    /// Walks the scope tree from innermost to outermost, looking for a\n    /// definition whose byte range matches the reference's name.\n    pub fn resolve_reference(\n        &self,\n        language: &Language,\n        entry: &GrammarEntry,\n        source: &str,\n        tree: &tree_sitter::Tree,\n        ref_start_byte: usize,\n        ref_end_byte: usize,\n    ) -> ResolvedScope {\n        let query = match self.get_query(language, entry) {\n            Some(q) => q,\n            None => return ResolvedScope::Unresolved,\n        };\n\n        let source_bytes = source.as_bytes();\n        let root = tree.root_node();\n        let mut cursor = tree_sitter::QueryCursor::new();\n        let capture_names = query.capture_names();\n\n        let mut scopes: Vec<Scope> = Vec::new();\n        let mut refs: Vec<LocalRef> = Vec::new();\n\n        let mut matches_iter = cursor.matches(query.as_ref(), root, source_bytes);\n        while let Some(mat) = matches_iter.next() {\n            for capture in mat.captures {\n                let node = capture.node;\n                let name = &capture_names[capture.index as usize];\n\n                if *name == \"scope\" {\n                    scopes.push(Scope {\n                        start_byte: node.start_byte(),\n                        end_byte: node.end_byte(),\n                        defs: Vec::new(),\n                    });\n                } else if let Some(kind) = name.strip_prefix(\"definition.\") {\n                    // Add to the innermost scope that contains this node.\n                    let def = LocalDef {\n                        start_byte: node.start_byte(),\n                        end_byte: node.end_byte(),\n                        kind: kind.to_owned(),\n                    };\n                    if let Some(scope) = scopes.iter_mut().rev().find(|s| {\n                        node.start_byte() >= s.start_byte && node.end_byte() <= s.end_byte\n                    }) {\n                        scope.defs.push(def);\n                    }\n                } else if let Some(kind) = name.strip_prefix(\"reference.\") {\n                    refs.push(LocalRef {\n                        start_byte: node.start_byte(),\n                        end_byte: node.end_byte(),\n                        kind: kind.to_owned(),\n                    });\n                }\n            }\n        }\n\n        // Sort scopes by start_byte descending (innermost first) for lookup.\n        scopes.sort_by(|a, b| b.start_byte.cmp(&a.start_byte));\n\n        // Find the definition matching the reference's text.\n        let ref_text = &source[ref_start_byte..ref_end_byte];\n\n        for scope in &scopes {\n            if ref_start_byte >= scope.start_byte && ref_end_byte <= scope.end_byte {\n                for def in &scope.defs {\n                    if def.start_byte == ref_start_byte && def.end_byte == ref_end_byte {\n                        return def_kind_to_resolved(&def.kind);\n                    }\n                    // Also match by text content (same name = same variable).\n                    let def_text = &source[def.start_byte..def.end_byte];\n                    if def_text == ref_text {\n                        return def_kind_to_resolved(&def.kind);\n                    }\n                }\n            }\n        }\n\n        ResolvedScope::Unresolved\n    }", "path": "crates/crabide-syntax/src/locals.rs"}
